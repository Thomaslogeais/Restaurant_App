    "@restaurant/api-client": "workspace:*",
    "@restaurant/shared": "workspace:*",
    "@tanstack/react-query": "^5.40.0",
    "expo": "~56.0.8",
    "expo-router": "^56.2.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.33.5",
    "typescript": "~6.0.3",
    "vitest": "^1.6.0"
  }
