{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@restaurant/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@restaurant/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@restaurant/types": [
        "../../packages/types/src/index.ts"
      ],
      "@restaurant/api-client": [
        "../../packages/api-client/src/generated/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts"
  ]
}
