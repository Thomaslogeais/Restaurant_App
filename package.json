{
  "name": "restaurant-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@restaurant/dashboard",
    "dev:backend": "turbo run dev --filter=@restaurant/backend",
    "gen:contract": "turbo run codegen --filter=@restaurant/api-client",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.7.1"
}
